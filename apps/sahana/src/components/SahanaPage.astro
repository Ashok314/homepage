---
import About from "@homepage/sections/About.astro";
import Features from "@homepage/sections/Features.astro";
import Footer from "@homepage/sections/Footer.astro";
import Gallery from "@homepage/sections/Gallery.astro";
import Header from "@homepage/sections/Header.astro";
import Hero from "@homepage/sections/Hero.astro";
import Menu from "@homepage/sections/Menu.astro";
import News from "@homepage/sections/News.astro";
import Section from "@homepage/ui/Section.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import type { BusinessContent } from "@homepage/content";
import type { BusinessTheme } from "@homepage/themes";

type Props = {
  content: BusinessContent;
  theme: BusinessTheme;
};

const { content, theme } = Astro.props;
const branches = content.branches ?? [];
const labels = content.locale?.labels ?? {};
const base = import.meta.env.BASE_URL;
const resolveAsset = (src: string) =>
  src.startsWith("http") ? src : `${base}${src.replace(/^\/+/, "")}`;
---

<BaseLayout content={content} theme={theme}>
  <a class="skip-link" href="#main">{labels.skipLink ?? "本文へ移動"}</a>
  <Header
    business={content.business}
    navigation={content.navigation}
    labels={labels}
    locale={content.locale}
  />
  {
    content.banner && (
      <section class="top-campaigns" aria-label={content.banner.title}>
        {content.banner.collapsible ? (
          <details
            class="top-campaigns__panel"
            open={content.banner.defaultOpen}
          >
            <summary>
              <span class="top-campaigns__title">{content.banner.title}</span>
              <span class="top-campaigns__toggle" aria-hidden="true" />
            </summary>
            <div class="top-campaigns__inner">
              {content.banner.items?.length ? (
                <div class="top-campaigns__list">
                  {content.banner.items.map((item) => (
                    <a
                      class="top-campaigns__item"
                      href={item.href}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {item.logo && (
                        <span class="top-campaigns__logo">
                          <img
                            src={resolveAsset(item.logo.src)}
                            alt={item.logo.alt}
                            loading="lazy"
                          />
                        </span>
                      )}
                      <span class="top-campaigns__content">
                        <strong>{item.title}</strong>
                        <span>{item.text}</span>
                      </span>
                      <span class="top-campaigns__cta">
                        {item.linkLabel ?? "詳しく見る"}
                      </span>
                    </a>
                  ))}
                </div>
              ) : (
                <div class="top-campaigns__single">
                  <div>
                    <strong>{content.banner.title}</strong>
                    <p>{content.banner.text}</p>
                  </div>
                  {content.banner.href && (
                    <a href={content.banner.href}>
                      {content.banner.linkLabel ?? "詳しく見る"}
                    </a>
                  )}
                </div>
              )}
            </div>
          </details>
        ) : (
          <div class="top-campaigns__panel">
            <div class="top-campaigns__inner">
              {content.banner.title && (
                <p class="top-campaigns__title">{content.banner.title}</p>
              )}
              {content.banner.items?.length ? (
                <div class="top-campaigns__list">
                  {content.banner.items.map((item) => (
                    <a
                      class="top-campaigns__item"
                      href={item.href}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {item.logo && (
                        <span class="top-campaigns__logo">
                          <img
                            src={resolveAsset(item.logo.src)}
                            alt={item.logo.alt}
                            loading="lazy"
                          />
                        </span>
                      )}
                      <span class="top-campaigns__content">
                        <strong>{item.title}</strong>
                        <span>{item.text}</span>
                      </span>
                      <span class="top-campaigns__cta">
                        {item.linkLabel ?? "詳しく見る"}
                      </span>
                    </a>
                  ))}
                </div>
              ) : (
                <div class="top-campaigns__single">
                  <div>
                    <strong>{content.banner.title}</strong>
                    <p>{content.banner.text}</p>
                  </div>
                  {content.banner.href && (
                    <a href={content.banner.href}>
                      {content.banner.linkLabel ?? "詳しく見る"}
                    </a>
                  )}
                </div>
              )}
            </div>
          </div>
        )}
      </section>
    )
  }
  <main id="main">
    <Hero hero={content.hero} />
    <About about={content.about} labels={labels} />

    {
      content.features && (
        <Features features={content.features} labels={labels} />
      )
    }

    <Section
      id="branches"
      eyebrow={labels.branchesEyebrow ?? "店舗情報"}
      title={labels.branchesTitle ?? "店舗情報"}
      intro={labels.branchesIntro}
    >
      <div class="branch-grid">
        {
          branches.map((branch) => (
            <article class="branch-card">
              <span class="branch-card__status">
                {branch.status === "active"
                  ? (labels.branchActive ?? "営業情報")
                  : (labels.branchVerification ?? "確認事項")}
              </span>
              <h3>{branch.name}</h3>
              {branch.address && <p>{branch.address}</p>}
              {branch.phone && (
                <a href={`tel:${branch.phone.replaceAll(/[^+\d]/g, "")}`}>
                  {branch.phone}
                </a>
              )}
              {branch.hours && (
                <ul>
                  {branch.hours.map((line) => (
                    <li>{line}</li>
                  ))}
                </ul>
              )}
              {branch.note && <small>{branch.note}</small>}
              <div class="branch-card__actions">
                {branch.mapUrl && (
                  <a
                    class="text-link"
                    href={branch.mapUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {labels.openMap ?? "Googleマップを開く"}
                  </a>
                )}
              </div>
              {branch.mapEmbedUrl && (
                <iframe
                  src={branch.mapEmbedUrl}
                  title={`${branch.name} ${labels.mapLabel ?? "地図"}`}
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                />
              )}
            </article>
          ))
        }
      </div>
    </Section>

    <Menu menu={content.menu} labels={labels} />

    {content.gallery && <Gallery gallery={content.gallery} labels={labels} />}

    {
      content.webOrder && (
        <Section
          id="order"
          eyebrow={labels.webOrderEyebrow ?? "WEB注文"}
          title={content.webOrder.title}
        >
          <div class="order-grid">
            {content.webOrder.links.map((link) =>
              link.href ? (
                <a
                  class="order-card"
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class="order-card__logo">
                    {link.logo ? (
                      <img
                        src={resolveAsset(link.logo.src)}
                        alt={link.logo.alt}
                        loading="lazy"
                      />
                    ) : (
                      link.logoText
                    )}
                  </span>
                  <strong>{link.label}</strong>
                  {link.campaign && <small>{link.campaign}</small>}
                </a>
              ) : (
                <span class="order-card order-card--disabled">
                  <span class="order-card__logo">
                    {link.logo ? (
                      <img
                        src={resolveAsset(link.logo.src)}
                        alt={link.logo.alt}
                        loading="lazy"
                      />
                    ) : (
                      link.logoText
                    )}
                  </span>
                  <strong>{link.label}</strong>
                  {link.campaign && <small>{link.campaign}</small>}
                </span>
              )
            )}
          </div>
        </Section>
      )
    }

    {
      content.posts && content.posts.length > 0 && (
        <News posts={content.posts} labels={labels} />
      )
    }
  </main>
  <Footer
    business={content.business}
    navigation={content.navigation}
    labels={labels}
  />

  <dialog
    class="image-dialog"
    id="image-dialog"
    aria-label={labels.imageDialogLabel ?? "画像の拡大表示"}
  >
    <form method="dialog">
      <button
        class="image-dialog__close"
        aria-label={labels.closeDialogLabel ?? "閉じる"}
      >
        {labels.closeDialogLabel ?? "閉じる"}
      </button>
    </form>
    <figure>
      <img id="image-dialog-src" alt="" />
      <figcaption id="image-dialog-title"></figcaption>
    </figure>
  </dialog>

  <script is:inline>
    const dialog = document.querySelector("#image-dialog");
    const dialogImage = document.querySelector("#image-dialog-src");
    const dialogTitle = document.querySelector("#image-dialog-title");

    document.querySelectorAll("[data-lightbox-image]").forEach((button) => {
      button.addEventListener("click", () => {
        if (!dialog || !dialogImage || !dialogTitle) return;

        dialogImage.src = button.dataset.lightboxSrc;
        dialogImage.alt = button.dataset.lightboxAlt || "";
        dialogTitle.textContent = button.dataset.lightboxTitle || "";

        if (typeof dialog.showModal === "function") {
          dialog.showModal();
        }
      });
    });

    dialog?.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
  </script>
</BaseLayout>

<style>
  :global(.site-header) {
    box-shadow: 0 8px 22px rgba(45, 23, 12, 0.08);
  }

  .top-campaigns {
    margin: 1.25rem auto 0;
    max-width: 1200px;
    padding: 0 1.5rem 0.85rem;
  }

  .top-campaigns__panel {
    background: color-mix(in srgb, var(--color-accent) 16%, white);
    border: 1px solid color-mix(in srgb, var(--color-accent) 50%, white);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .top-campaigns__panel summary {
    align-items: center;
    cursor: pointer;
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    list-style: none;
    padding: 1rem 1.2rem;
  }

  .top-campaigns__panel summary::-webkit-details-marker {
    display: none;
  }

  .top-campaigns__toggle::before {
    content: "+";
    display: inline-block;
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1;
  }

  .top-campaigns__panel[open] .top-campaigns__toggle::before {
    content: "-";
  }

  .top-campaigns__inner {
    display: grid;
    gap: 0.85rem;
    padding: 1rem 1.2rem;
  }

  .top-campaigns__panel summary + .top-campaigns__inner {
    padding-top: 0;
  }

  .top-campaigns__title {
    color: var(--color-primary);
    font-size: 0.9rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    margin: 0;
    text-transform: uppercase;
  }

  .top-campaigns__list {
    display: grid;
    gap: 0.7rem;
  }

  .top-campaigns__item {
    align-items: center;
    color: inherit;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: 40px minmax(0, 1fr) auto;
    text-decoration: none;
  }

  .top-campaigns__logo {
    align-items: center;
    display: inline-flex;
    height: 40px;
    justify-content: center;
    width: 40px;
  }

  .top-campaigns__logo img {
    display: block;
    max-height: 28px;
    max-width: 40px;
    width: auto;
  }

  .top-campaigns__content {
    align-items: baseline;
    display: flex;
    gap: 0.45rem;
    min-width: 0;
    white-space: nowrap;
  }

  .top-campaigns__content strong {
    color: var(--color-primary);
    flex: 0 0 auto;
    font-size: 0.95rem;
  }

  .top-campaigns__content span {
    color: var(--color-muted);
    line-height: 1.2;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .top-campaigns__cta {
    color: var(--color-primary);
    font-size: 0.85rem;
    font-weight: 900;
    white-space: nowrap;
  }

  .top-campaigns__single {
    align-items: center;
    display: flex;
    gap: 1rem;
    justify-content: space-between;
  }

  .top-campaigns__single p {
    margin: 0.2rem 0 0;
  }

  .branch-grid,
  .order-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .branch-card,
  .order-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    color: var(--color-text);
    padding: 1.2rem;
  }

  .branch-card {
    display: grid;
    gap: 0.8rem;
  }

  .branch-card__status {
    background: color-mix(in srgb, var(--color-accent) 18%, white);
    border-radius: 999px;
    color: var(--color-primary);
    display: inline-flex;
    font-size: 0.76rem;
    font-weight: 900;
    justify-self: start;
    padding: 0.28rem 0.6rem;
  }

  h3 {
    font-family: var(--font-heading);
    font-size: 1.55rem;
    line-height: 1.1;
    margin: 0;
  }

  p,
  li,
  small {
    color: var(--color-muted);
    line-height: 1.65;
  }

  p,
  ul {
    margin: 0;
  }

  ul {
    list-style: none;
    padding: 0;
  }

  a {
    color: var(--color-primary);
    font-weight: 800;
    text-underline-offset: 0.22em;
  }

  .branch-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  iframe {
    aspect-ratio: 16 / 10;
    border: 0;
    border-radius: calc(var(--radius) - 2px);
    min-height: 240px;
    width: 100%;
  }

  .order-card {
    align-items: center;
    display: grid;
    gap: 0.65rem;
    justify-items: center;
    min-height: 168px;
    text-align: center;
    text-decoration: none;
  }

  .order-card--disabled {
    opacity: 0.72;
  }

  .order-card__logo {
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    display: inline-flex;
    font-weight: 900;
    height: 72px;
    justify-content: center;
    min-width: 112px;
    padding: 0.75rem;
  }

  .order-card__logo img {
    display: block;
    max-height: 42px;
    width: auto;
  }

  .image-dialog {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: 0 24px 80px rgba(28, 14, 6, 0.32);
    color: var(--color-text);
    max-height: min(92vh, 920px);
    max-width: min(92vw, 980px);
    padding: 1rem;
    width: max-content;
  }

  .image-dialog::backdrop {
    background: rgba(20, 12, 6, 0.72);
  }

  .image-dialog form {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 0.75rem;
  }

  .image-dialog__close {
    background: var(--color-primary);
    border: 0;
    border-radius: var(--radius);
    color: var(--color-primary-text);
    cursor: pointer;
    font-weight: 850;
    padding: 0.55rem 0.85rem;
  }

  .image-dialog figure {
    display: grid;
    gap: 0.65rem;
    margin: 0;
  }

  .image-dialog img {
    display: block;
    max-height: 74vh;
    max-width: min(86vw, 920px);
    object-fit: contain;
    width: auto;
  }

  .image-dialog figcaption {
    color: var(--color-muted);
    font-weight: 850;
    line-height: 1.5;
    text-align: center;
  }

  @media (max-width: 760px) {
    .top-campaigns {
      padding-inline: 1rem;
    }

    .top-campaigns__item {
      align-items: center;
      grid-template-columns: 34px minmax(0, 1fr) auto;
    }

    .top-campaigns__logo {
      height: 34px;
      width: 34px;
    }

    .top-campaigns__logo img {
      max-height: 24px;
      max-width: 34px;
    }

    .top-campaigns__content strong,
    .top-campaigns__content span,
    .top-campaigns__cta {
      font-size: 0.82rem;
    }

    .branch-grid,
    .order-grid {
      grid-template-columns: 1fr;
    }

    .top-campaigns__single {
      align-items: stretch;
      flex-direction: column;
    }
  }
</style>
