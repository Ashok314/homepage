---
import type { BusinessContent } from "@homepage/content";

type Props = {
  business: BusinessContent["business"];
  navigation: BusinessContent["navigation"];
  labels?: NonNullable<BusinessContent["locale"]>["labels"];
  locale?: BusinessContent["locale"];
};

const { business, navigation, labels = {}, locale } = Astro.props;
const base = import.meta.env.BASE_URL;
const fallbackMark = business.name.trim().charAt(0).toUpperCase();
const activeLocale = locale?.defaultLocale;
const logoSrc =
  business.logo &&
  (business.logo.src.startsWith("http")
    ? business.logo.src
    : `${base}${business.logo.src.replace(/^\/+/, "")}`);
const localeChoices =
  locale?.available.map((item) => ({
    ...item,
    href: item.href?.startsWith("http")
      ? item.href
      : `${base}${item.href ?? ""}`
  })) ?? [];
---

<header class="site-header">
  <a
    class="brand"
    href="#top"
    aria-label={labels.homeLabel ?? `${business.name} トップ`}
  >
    {
      business.logo ? (
        <img src={logoSrc} alt={business.logo.alt} />
      ) : (
        <>
          <span class="brand__mark" aria-hidden="true">
            {fallbackMark}
          </span>
          <span>
            <strong>{business.name}</strong>
            <small>{business.type}</small>
          </span>
        </>
      )
    }
  </a>
  <div class="header-actions">
    <nav aria-label={labels.mainNavigation ?? "メインナビゲーション"}>
      {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    {
      locale && locale.available.length > 1 && (
        <label class="language-select">
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
          >
            <circle cx="12" cy="12" r="10" />
            <path d="M2 12h20" />
            <path d="M12 2a15.3 15.3 0 0 1 0 20" />
            <path d="M12 2a15.3 15.3 0 0 0 0 20" />
          </svg>
          <span>{labels.languageNavigation ?? "言語切り替え"}</span>
          <select
            aria-label={labels.languageNavigation ?? "言語切り替え"}
            onchange="if (this.value) window.location.href = this.value"
          >
            {localeChoices.map((item) => (
              <option value={item.href} selected={item.code === activeLocale}>
                {item.label}
              </option>
            ))}
          </select>
        </label>
      )
    }
  </div>
</header>

<style>
  .site-header {
    align-items: center;
    background: var(--color-primary);
    border-bottom: 4px solid var(--color-accent);
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    left: 0;
    padding: 0.85rem clamp(1rem, 4vw, 2rem);
    position: sticky;
    right: 0;
    top: 0;
    z-index: 10;
  }

  .brand {
    align-items: center;
    color: var(--color-primary-text);
    display: inline-flex;
    gap: 0.65rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .brand img {
    display: block;
    height: 4rem;
    width: auto;
  }

  .brand strong {
    display: block;
    font-family: var(--font-heading);
    font-size: 1.35rem;
    letter-spacing: 0.04em;
    line-height: 1;
  }

  .brand small {
    color: color-mix(
      in srgb,
      var(--color-primary-text) 86%,
      var(--color-accent)
    );
    display: block;
    font-size: 0.78rem;
    font-weight: 800;
    margin-top: 0.15rem;
  }

  .brand__mark {
    background: var(--color-accent);
    border: 2px solid
      color-mix(in srgb, var(--color-primary-text) 88%, var(--color-accent));
    border-radius: 4px;
    color: var(--color-text);
    display: grid;
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 900;
    height: 2.1rem;
    place-items: center;
    width: 2.1rem;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    justify-content: flex-end;
  }

  .header-actions {
    align-items: flex-end;
    display: grid;
    gap: 0.5rem;
    justify-items: end;
  }

  nav a,
  .language-nav span {
    color: var(--color-primary-text);
    font-size: 0.94rem;
    font-weight: 850;
    text-decoration: none;
  }

  nav a:hover {
    color: var(--color-accent);
  }

  .language-select {
    align-items: center;
    border: 1px solid
      color-mix(in srgb, var(--color-primary-text) 36%, transparent);
    border-radius: 999px;
    color: var(--color-primary-text);
    display: inline-flex;
    gap: 0.4rem;
    padding: 0.3rem 0.5rem;
  }

  .language-select svg {
    height: 1rem;
    width: 1rem;
  }

  .language-select span {
    font-size: 0.76rem;
    font-weight: 800;
  }

  .language-select select {
    appearance: none;
    background: transparent;
    border: 0;
    color: var(--color-primary-text);
    cursor: pointer;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 850;
    padding: 0;
  }

  @media (max-width: 1024px) {
    .site-header {
      align-items: center;
      display: flex;
      flex-wrap: nowrap;
      gap: 0.5rem;
      padding: 0.45rem 0.8rem;
    }

    .header-actions {
      align-items: center;
      display: flex;
      flex: 1;
      gap: 0.45rem;
      justify-content: flex-end;
      min-width: 0;
    }

    nav {
      display: flex;
      flex: 0 1 auto;
      flex-wrap: nowrap;
      gap: 0.25rem 0.5rem;
      justify-content: flex-end;
      margin-left: auto;
      max-width: 100%;
      min-width: 0;
      overflow-x: auto;
      overflow-y: hidden;
      scrollbar-width: none;
      white-space: nowrap;
    }

    nav::-webkit-scrollbar {
      display: none;
    }

    .brand img {
      height: 2.35rem;
    }

    .brand {
      flex: 0 0 auto;
      gap: 0.45rem;
      min-width: 0;
    }

    nav a {
      display: inline-flex;
      font-size: 0.8rem;
      white-space: nowrap;
    }

    .language-select {
      align-items: center;
      display: inline-flex;
      flex: 0 0 auto;
      min-height: 2rem;
      padding: 0.22rem;
      position: relative;
      width: 2rem;
    }

    .language-select span {
      display: none;
    }

    .language-select svg {
      height: 0.95rem;
      margin: 0 auto;
      width: 0.95rem;
    }

    .language-select select {
      inset: 0;
      opacity: 0;
      position: absolute;
      width: 100%;
    }
  }

  @media (max-width: 720px) {
    .site-header {
      gap: 0.3rem 0.55rem;
      padding: 0.35rem 0.65rem;
    }

    nav {
      gap: 0.22rem 0.38rem;
    }

    .brand img {
      height: 1.9rem;
    }

    nav a {
      font-size: 0.69rem;
    }

    .language-select {
      min-height: 1.85rem;
      width: 1.85rem;
    }
  }
</style>
